# Build, cache and editor output. The Astro site has its own .gitignore in
# docs/ covering dist/, .astro/ and node_modules/.

# These name paths *inside* `.claude/` rather than ignoring `.claude/` itself,
# so that shared agent config committed there in future is not swallowed. That
# is the convention across these repositories; this repo has no `.claude/`
# directory today, so both entries are pre-emptive.
.claude/settings.local.json
.claude/worktrees

.DS_Store
